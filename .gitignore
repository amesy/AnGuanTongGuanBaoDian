# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.cache/

# Generated Electron application and installers
dist/
release-src/
/*.exe
/*.exe.blockmap
/*.blockmap

# Test results and coverage (keep tests/ and scripts/)
coverage/
.nyc_output/
test-results/
playwright-report/

# Temporary files and isolated test/build profiles
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej

# Logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and private signing material
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pfx
*.p12
*.key

# Local assistant settings and internal diagnostic notes
/.claude/settings.local.json
/OPTIMIZATION_REPORT.md

# Operating-system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Local editor state
.vscode/
.idea/
.vs/
*.swp
*.swo

# Keep source code, assets/icon.ico, package-lock.json, .editorconfig,
# README.md, and RELEASE_NOTES_*.md under version control.
